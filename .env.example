# サーバー専用。NEXT_PUBLIC_ を付けないでください。
OPENAI_API_KEY=your_api_key_here

# 必要な場合のみ上書き。未指定時は gpt-4.1。
OPENAI_MODEL=gpt-4.1

# Neonのproductionブランチ用。必ず接続プール付きURLを使用してください。
DATABASE_URL=your_neon_pooled_connection_string

# Neon Object Storageの非公開バケット名。認証情報はサーバー環境変数だけで扱います。
NEON_STORAGE_BUCKET=case-assets
AWS_ENDPOINT_URL_S3=your_neon_s3_endpoint
AWS_ACCESS_KEY_ID=your_neon_storage_access_key
AWS_SECRET_ACCESS_KEY=your_neon_storage_secret_key
AWS_REGION=your_neon_storage_region

# LINE Messaging API。いずれもサーバー専用で、NEXT_PUBLIC_ を付けないでください。
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# 本番環境では両方が true の場合だけ実画像解析を有効化します。
# 料金ゼロのサンプル専用デモでは false のままにしてください。
ENABLE_LIVE_ANALYSIS=false
NEXT_PUBLIC_ENABLE_LIVE_ANALYSIS=false
